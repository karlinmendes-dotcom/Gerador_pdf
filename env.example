# ─────────────────────────────────────────────
# PDFForge Brasil — Variáveis de Ambiente
# Copie para .env.local (dev) e configure na Vercel (prod)
# ─────────────────────────────────────────────

# Convex (Banco de Dados & Storage)
VITE_CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# IA — Google Gemini (usada na rota /api/generate-document)
GEMINI_API_KEY=

# IA — Groq / Meta Llama (alternativa na rota /api/generate-document)
GROQ_API_KEY=

# Mercado Pago — PIX (rotas /api/checkout, /api/status, /api/webhooks/mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Opcional — URL base para webhooks/retornos
NEXT_PUBLIC_APP_URL=
